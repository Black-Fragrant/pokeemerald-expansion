script NimbasaCityExtended_EventScript_NBT_Pos5
{
	applymovement(LOCALID_NCE_N, moves(walk_left, walk_down * 3, walk_left * 1))
	waitmovement(0)
	applymovement(LOCALID_PLAYER, moves(walk_right))
	waitmovement(0)
    return
}

script NimbasaCityExtended_EventScript_NBT_Pos6
{
	applymovement(LOCALID_PLAYER, moves(delay_8, walk_right * 4, walk_down * 4, walk_right * 27))
	applymovement(LOCALID_NCE_N, moves(walk_right * 3, walk_down * 4, walk_right * 29))
	waitmovement(0)
    return
}

