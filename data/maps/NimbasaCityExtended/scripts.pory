	applymovement(LOCALID_PLAYER, moves(delay_8, walk_right * 30))
	applymovement(LOCALID_NCE_N, moves(walk_right * 31))
	waitmovement(0)
    return
}

script NimbasaCityExtended_EventScript_GymSign
{
    msgbox("Nimbasa City Pokémon Gym\n"
        "Leader: Elesa\l"
        "The Shining Beauty", MSGBOX_SIGN)
	end
}

