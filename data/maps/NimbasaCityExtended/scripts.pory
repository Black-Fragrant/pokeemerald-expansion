	applymovement(LOCALID_PLAYER, moves(delay_8, walk_right * 21, walk_down * 3, walk_right * 10))
	applymovement(LOCALID_NCE_N, moves(walk_right * 20, walk_down * 3, walk_right * 12))
	waitmovement(0)
    return
}

