	applymovement(LOCALID_PLAYER, moves(delay_8, walk_right * 4, walk_down * 1, walk_right * 27))
	applymovement(LOCALID_NCE_N, moves(walk_right * 3, walk_down * 1, walk_right * 29))
	waitmovement(0)
