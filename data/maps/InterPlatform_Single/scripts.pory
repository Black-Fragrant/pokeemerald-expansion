script InterPlatform_Single_EventScript_Janitor_21
{
    lock
    faceplayer
    goto_if_set(FLAG_TEMP_13, InterPlatform_Single_EventScript_JanitorAfterItem_21)
    msgbox("I found this when I was cleaning.\n"
        "You can have it if you'd like.", MSGBOX_DEFAULT, TRUE, VAR_LAST_TALKED)
    destroy_speech_bubble()
    closemessage
	giveitem(ITEM_PP_UP, 1)
	goto_if_eq (VAR_RESULT, FALSE, Common_EventScript_BagIsFull_EndScript)
    setflag(FLAG_TEMP_13)
    goto(InterPlatform_Single_EventScript_JanitorAfterItem_21)
}

