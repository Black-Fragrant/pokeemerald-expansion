script CasteliaCity_CasteliaGym_EventScript_Button1
{
    lock
    goto_if_set(FLAG_TEMP_11, CasteliaCity_CasteliaGym_EventScript_Button1_Reset)
    setflag(FLAG_TEMP_11)
    call(NimbasaCity_NimbasaGym_EventScript_Track1Altered)
	special(DrawWholeMapView)
    call(NimbasaCity_NimbasaGym_EventScript_ButtonText)
    release
    end
}

