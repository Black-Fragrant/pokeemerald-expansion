mapscripts NimbasaCity_NimbasaGym_MapScripts 
    {
        MAP_SCRIPT_ON_LOAD : NimbasaCity_NimbasaGym_On_Load
        MAP_SCRIPT_ON_TRANSITION : NimbasaCity_NimbasaGym_On_Transition
    }

script NimbasaCity_NimbasaGym_On_Load
{
	call_if_set(FLAG_TEMP_11, NimbasaCity_NimbasaGym_EventScript_Track1Altered)
	call_if_set(FLAG_TEMP_12, NimbasaCity_NimbasaGym_EventScript_Track2Altered)
	call_if_set(FLAG_TEMP_13, NimbasaCity_NimbasaGym_EventScript_Track3Altered)
	call_if_set(FLAG_TEMP_14, NimbasaCity_NimbasaGym_EventScript_Track4Altered)
	end()
}

script NimbasaCity_NimbasaGym_EventScript_Track1Altered
{
	setmetatile (30, 36, 0x201, FALSE)
	return()
}

script NimbasaCity_NimbasaGym_EventScript_Track1Reset
{
	setmetatile (30, 36, 0x200, FALSE)
	return()
}

