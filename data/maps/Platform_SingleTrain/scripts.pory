mapscripts Platform_SingleTrain_MapScripts 
{
        MAP_SCRIPT_ON_FRAME_TABLE
    [
        VAR_TEMP_CHALLENGE_STATUS, 0 : Platform_SingleTrain_EventScript_GetChallengeStatus
        VAR_TEMP_CHALLENGE_STATUS, CHALLENGE_STATUS_SAVING: Platform_SingleTrain_EventScript_QuitWithoutSaving
        VAR_TEMP_CHALLENGE_STATUS, CHALLENGE_STATUS_PAUSED: Platform_SingleTrain_EventScript_ResumeChallenge
        VAR_TEMP_CHALLENGE_STATUS, CHALLENGE_STATUS_LOST: Platform_SingleTrain_EventScript_LostChallenge
        VAR_BATTLE_SUBWAY_BOARDING, CHALLENGE_STATUS_RETURN: Platform_SingleTrain_EventScript_RideBackToNimbasa
        VAR_BATTLE_SUBWAY_BOARDING, CHALLENGE_STATUS_FINAL_STOP: Platform_SingleTrain_EventScript_RideBackToNimbasa
    ]
}

script Platform_SingleTrain_EventScript_GetChallengeStatus
{
	frontier_getstatus
	end
}

script Platform_SingleTrain_EventScript_QuitWithoutSaving
{
	lock
    applymovement(LOCALID_SINGLETRAIN_AGENT, moves(face_player))
    waitmovement(0)
	msgbox("Excuse me!\p"
            "You didn't save before you quit your\n"
            "challenge last time.\p"
            "I am sorry, but you'll have to start\n"
            "your challenge over again.", MSGBOX_DEFAULT, TRUE, LOCALID_SINGLETRAIN_AGENT)
    destroy_speech_bubble()
    closemessage()
	special(LoadPlayerParty)
	setsubwaywinstreak(FRONTIER_MODE_SINGLES, 0)
	tower_set(TOWER_DATA_WIN_STREAK_ACTIVE, FALSE)
	frontier_set(FRONTIER_DATA_CHALLENGE_STATUS, 0)
	setvar(VAR_TEMP_CHALLENGE_STATUS, 255)
    goto(Platform_SingleTrain_EventScript_Cancel_Cont)
}

script Platform_SingleTrain_EventScript_WalkFromTrainToConductor
{
    applymovement(LOCALID_PLAYER, BattleSubway_Movement_PlayerWalkBackFromTrain)
    applymovement(LOCALID_SINGLETRAIN_AGENT, BattleSubway_Movement_ConductorLookAtPlayerWalkingBack)
    waitmovement(0)
    return
}

script Platform_SingleTrain_EventScript_LostChallenge
{
	lock
    call(Platform_SingleTrain_EventScript_WalkFromTrainToConductor)
	setsubwaywinstreak(FRONTIER_MODE_SINGLES, 0)
	tower_set(TOWER_DATA_WIN_STREAK_ACTIVE, FALSE)
	setvar(VAR_TEMP_CHALLENGE_STATUS, 255)
	goto(Platform_SingleTrain_EventScript_LoadPartyCancelChallenge)
}

script Platform_SingleTrain_EventScript_RideBackToNimbasa
{
	lock
    call(Platform_SingleTrain_EventScript_WalkFromTrainToConductor)
	setvar(VAR_TEMP_CHALLENGE_STATUS, 255)
    setvar(VAR_BATTLE_SUBWAY_BOARDING, 0)
    msgbox(BattleSubway_Text_ThankYouForPlaying, MSGBOX_DEFAULT, TRUE, LOCALID_SINGLETRAIN_AGENT)
    destroy_speech_bubble()
    closemessage()
    release
    end
}

script Platform_SingleTrain_EventScript_ResumeChallenge
{
	lock
    applymovement(LOCALID_SINGLETRAIN_AGENT, moves(face_player))
    applymovement(LOCALID_PLAYER, moves(face_right))
    waitmovement(0)
	msgbox("It's good to see you back.\p"
            "Would you like to resume your challenge\n"
            "at the Battle Subway?", MSGBOX_YESNO, TRUE, LOCALID_SINGLETRAIN_AGENT)
    destroy_speech_bubble()
    closemessage()
    goto_if_eq(VAR_RESULT, TRUE, Platform_SingleTrain_EventScript_ResumeChallenge2)
	fadescreen(FADE_TO_BLACK)
	frontier_reset //performs a soft reset
    end
}

script Platform_SingleTrain_EventScript_ResumeChallenge2
{
    delay(10)
	msgbox(BattleSubway_Text_SavingDontTurnOff, MSGBOX_TRANSPARENT)
	waitmessage
	tower_save(CHALLENGE_STATUS_SAVING)
	playse(SE_SAVE)
	waitse
    closemessage
	msgbox("Now, I will guid you to the place\n"
            "where you interrupted your challenge.", MSGBOX_DEFAULT, TRUE, LOCALID_SINGLETRAIN_AGENT)
    destroy_speech_bubble()
    closemessage()
	frontier_set(FRONTIER_DATA_PAUSED, FALSE)
    // Only writes a single boolean (challengePaused = FALSE) and does nothing else. They are not interchangeable. One is a full save operation, the other is a single flag write.
	goto(Platform_SingleTrain_EventScript_BoardTheTrain)
	end
}

script Platform_SingleTrain_EventScript_Trigger
{
    lock
    call(BattleSubway_EventScript_Platform_StopPlayerAtConductor)
    applymovement(LOCALID_SINGLETRAIN_AGENT, moves(face_player))
    waitmovement(0)
	setvar(VAR_FRONTIER_FACILITY, FRONTIER_FACILITY_TOWER) 
	special(SavePlayerParty)
	msgbox("Welcome to the Battle Subway!\p"
            "I will guide you to\n"
            "the Single Train here.", MSGBOX_DEFAULT, TRUE, LOCALID_SINGLETRAIN_AGENT)
    goto(Platform_SingleTrain_EventScript_Selection)
}

script Platform_SingleTrain_EventScript_Selection
{
	msgbox("Would you like to board\n"
            "the Single Train?", MSGBOX_DEFAULT, FALSE)
    waitmessage
	dynmultichoice(20, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE,
        "Board",
        "Info",
        "Cancel")
    destroy_speech_bubble()
	if (var(VAR_RESULT) == 0) {goto (Platform_SingleTrain_EventScript_Prepare)}
	elif (var(VAR_RESULT) == 1) {goto (Platform_SingleTrain_EventScript_Info)}
    goto(Platform_SingleTrain_EventScript_Cancel)
}

script Platform_SingleTrain_EventScript_Info
{
    msgbox("In the Single Train, you will battle\n"
            "using three Pokémon.\p"
            "You may not have duplicate Pokémon\n"
            "or duplicate held items.\p"
            "All Pokémon will be temporarily set to\n"
            "Lv. 50 for the battles here.\p"
            "The Single Train has seven cars, so you\n"
            "will fight against seven Trainers.\p"
            "If you manage to defeat all seven,\n"
            "you will arrive at a station and earn\l"
            "Battle Points (BP).\l"
            "Good luck!\p"
            "If you need a break from your challenge,\n"
            "remember to save the game!\p"
            "If you don't save, you'll have to start\n"
            "the challenge all over again.\l"
            "Please be aware of that!", MSGBOX_DEFAULT, TRUE, LOCALID_SINGLETRAIN_AGENT)
    goto(Platform_SingleTrain_EventScript_Selection)
}

script Platform_SingleTrain_EventScript_CancelChallengeSaveFailed
{
	frontier_set(FRONTIER_DATA_CHALLENGE_STATUS)  // No status provided, so it relies on VAR_0x8006 being 0 already
	goto(Platform_SingleTrain_EventScript_Cancel)
}

script Platform_SingleTrain_EventScript_LoadPartyCancelChallenge
{
	special(LoadPlayerParty)
	callnative(UpdateFollowingPokemon)
    goto(Platform_SingleTrain_EventScript_Cancel)
}

script Platform_SingleTrain_EventScript_Cancel
{
	msgbox(BattleSubway_Text_WeHopeToSeeYouAgain, MSGBOX_DEFAULT, TRUE, LOCALID_SINGLETRAIN_AGENT)
    destroy_speech_bubble()
    closemessage
    goto(Platform_SingleTrain_EventScript_Cancel_Cont)
}

script Platform_SingleTrain_EventScript_Cancel_Cont
{
    goto(BattleSubway_EventScript_Platform_ForcePlayerWalkLeftUponCancel)

}

script Platform_SingleTrain_EventScript_NotEnoughValidMons
{
    msgbox("You don't have three\n"
            "eligible Pokémon!\p"
            "Please prepare three\n"
            "different Pokémon\l"
            "and have each of them hold\l"
            "a different item to enter the battle.\p"
            "Eggs and Mythical Pokémon are\n"
            "not allowed to enter!", MSGBOX_TRANSPARENT)
    closemessage
    goto (Platform_SingleTrain_EventScript_Cancel)
}

script Platform_SingleTrain_EventScript_Prepare
{
	setvar(VAR_FRONTIER_BATTLE_MODE, FRONTIER_MODE_SINGLES)
	frontier_checkineligible //research complete - checks for all levels but store the result of level 50 mode
	goto_if_eq(VAR_0x8004, TRUE, Platform_SingleTrain_EventScript_NotEnoughValidMons) 
	msgbox(BattleSubway_Text_PleaseSelectThreePokemonYouWishToEnter, MSGBOX_DEFAULT, TRUE, LOCALID_SINGLETRAIN_AGENT)
    destroy_speech_bubble()
    closemessage
	fadescreen(FADE_TO_BLACK)
	callnative(RemoveFollowingPokemon)
	setvar(VAR_0x8005, FRONTIER_PARTY_SIZE) //research complete, this var is defined to be 3
	special(ChoosePartyForBattleFrontier) //
	goto_if_eq(VAR_RESULT, 0, Platform_SingleTrain_EventScript_LoadPartyCancelChallenge)
	msgbox (BattleSubway_Text_WouldYouLikeToSave, MSGBOX_YESNO, TRUE, LOCALID_SINGLETRAIN_AGENT)
    destroy_speech_bubble()
    closemessage
	goto_if_eq(VAR_RESULT, YES, Platform_SingleTrain_EventScript_SaveBeforeChallenge)
	goto (Platform_SingleTrain_EventScript_LoadPartyCancelChallenge)
}

script Platform_SingleTrain_EventScript_SaveBeforeChallenge
{
	frontier_set(FRONTIER_DATA_SELECTED_MON_ORDER) //It copies the player’s selected party order into the Frontier saveblock
	setvar(VAR_TEMP_CHALLENGE_STATUS, CHALLENGE_STATUS_SAVING) // VAR_TEMP_CHALLENGE_STATUS is used to react to the status in OnFrame map scripts
	// tower_init // decides which Trainer Tower floor layout to load when entering a floor
	tower_set(TOWER_DATA_WIN_STREAK_ACTIVE, TRUE) // indicate that the win streak is currently active.
	frontier_set(FRONTIER_DATA_PAUSED, FALSE) // Marks whether the Frontier challenge is paused.
	closemessage
	delay(2)
	call(Common_EventScript_SaveGame)
	setvar(VAR_TEMP_CHALLENGE_STATUS, 255) // 4-255 does nothing, does not activate map scripts
	goto_if_eq (VAR_RESULT, 0, Platform_SingleTrain_EventScript_CancelChallengeSaveFailed)
	incrementgamestat(GAME_STAT_ENTERED_BATTLE_TOWER) //you have entered the tower +1 times
	goto(Platform_SingleTrain_EventScript_BoardTheTrain)
}

script Platform_SingleTrain_EventScript_BoardTheTrain
{
	setvar(VAR_0x8004, FRONTIER_UTIL_FUNC_SET_PARTY_ORDER) // these three load the saved Frontier party selection
	setvar(VAR_0x8005, FRONTIER_PARTY_SIZE) 
	special(CallFrontierUtilFunc)
    callnative(SetPartyToLevel50)
	setvar(VAR_RESULT, 0)
	msgbox("Now, please board\n"
            "the Single Train!", MSGBOX_DEFAULT, TRUE, LOCALID_SINGLETRAIN_AGENT)
    destroy_speech_bubble()
    closemessage
	getplayerxy (VAR_TEMP_0, VAR_TEMP_1)
	call_if_eq (VAR_TEMP_1, 9, Platform_SingleTrain_EventScript_BTT_Pos1)
	call_if_eq (VAR_TEMP_1, 10, Platform_SingleTrain_EventScript_BTT_Pos2)
	call_if_eq (VAR_TEMP_1, 11, Platform_SingleTrain_EventScript_BTT_Pos3)
    playse(SE_EXIT)
    waitse
    delay(20)
    removeobject(LOCALID_SINGLETRAIN_0)
    addobject(LOCALID_SINGLETRAIN_1)
    applymovement(LOCALID_SINGLETRAIN_1, BattleSubway_Movement_TrainLeavingStation)
    applymovement(LOCALID_SINGLETRAIN_2, BattleSubway_Movement_TrainLeavingStation)
    applymovement(LOCALID_SINGLETRAIN_3, BattleSubway_Movement_TrainLeavingStation)
    waitmovement(0)
	fadescreen(FADE_TO_BLACK)
	setvar(VAR_TEMP_CHALLENGE_STATUS, 0) // set to 0 so the map scripts will run a diagnosis
	tower_setopponent // 1. check special trainers 2. find normal trainer 3. TRAINER SPRITES
	frontier_get(FRONTIER_DATA_BATTLE_NUM)
	goto_if_eq(VAR_RESULT, 0, Platform_SingleTrain_EventScript_BoardTheTrain2) //this is the first person you battle
	warpsilent(MAP_BATTLE_SUBWAY_SINGLE, 1, 5)
	waitstate
	end
}

script Platform_SingleTrain_EventScript_BoardTheTrain2
{
	warpsilent(MAP_BATTLE_SUBWAY_SINGLE, 2, 7)
	waitstate
	end
}

script Platform_SingleTrain_EventScript_BTT_Pos1
{
    applymovement(LOCALID_SINGLETRAIN_AGENT, BattleSubway_Movement_ConductorLeadToBoard)
    applymovement(LOCALID_PLAYER, BattleSubway_Movement_PlayerBoardingTheTrain_Pos1)
    waitmovement(0)
    return
}

script Platform_SingleTrain_EventScript_BTT_Pos2
{
    applymovement(LOCALID_SINGLETRAIN_AGENT, BattleSubway_Movement_ConductorLeadToBoard)
    applymovement(LOCALID_PLAYER, BattleSubway_Movement_PlayerBoardingTheTrain_Pos2)
    waitmovement(0)
    return
}

script Platform_SingleTrain_EventScript_BTT_Pos3
{
    applymovement(LOCALID_SINGLETRAIN_AGENT, BattleSubway_Movement_ConductorLeadToBoard)
    applymovement(LOCALID_PLAYER, BattleSubway_Movement_PlayerBoardingTheTrain_Pos3)
    waitmovement(0)
    return
}





