mapscripts Platform_SuperMultiTrain_MapScripts {}

script Platform_SuperMultiTrain_EventScript_Trigger
{
    lock
    call(BattleSubway_EventScript_Platform_StopPlayerAtConductor)
    applymovement(LOCALID_SUPERMULTITRAIN_AGENT, Common_Movement_FacePlayer)
    waitmovement(0)
	setvar(VAR_FRONTIER_FACILITY, FRONTIER_FACILITY_TOWER) 
	special(SavePlayerParty)
	bufferstring(STR_VAR_1, text("Multi"))
	msgbox(BattleSubway_Text_SorrySuperTrainNotReady, MSGBOX_DEFAULT, TRUE, LOCALID_SUPERMULTITRAIN_AGENT)
    destroy_speech_bubble()
    goto(Platform_SuperMultiTrain_EventScript_Cancel)
}

script Platform_SuperMultiTrain_EventScript_Cancel
{
	msgbox(BattleSubway_Text_WeHopeToSeeYouAgain, MSGBOX_DEFAULT, TRUE, LOCALID_SUPERMULTITRAIN_AGENT)
    destroy_speech_bubble()
    closemessage
    call(BattleSubway_EventScript_Platform_ForcePlayerWalkLeftUponCancel)
	applymovement(LOCALID_SUPERMULTITRAIN_AGENT, Common_Movement_FaceLeft)
	waitmovement(0)
	release
	end
}
