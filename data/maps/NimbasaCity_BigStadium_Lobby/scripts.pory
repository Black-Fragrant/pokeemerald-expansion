{
    goto_if_unset(FLAG_NIMBASA_CITY_SMALL_COURT_GAME_ONGOING, NimbasaCity_BigStadium_Lobby_EventScript_Receptionist_SoccerActive)
    msgbox("Soccer players are practicing\n"
        "in Big Stadium now!\p"
        "People can watch them practicing!", MSGBOX_DEFAULT, TRUE, LOCALID_NCBSL_RECEPTIONIST)
