script NimbasaCity_BigStadium_Lobby_EventScript_Receptionist_3
{
    goto_if_unset(FLAG_NIMBASA_CITY_SMALL_COURT_GAME_ONGOING, NimbasaCity_BigStadium_Lobby_EventScript_Receptionist_FootballActive)
    msgbox("Football players are practicing in\n"
        "Big Stadium now.\p"
        "People can watch them practicing!", MSGBOX_DEFAULT, TRUE, LOCALID_NCBSL_RECEPTIONIST)
