script NimbasaCity_EventScript_GiveVSRecorder
{
	lock
	playse(SE_PIN)
	applymovement(LOCALID_PLAYER, moves(emote_exclamation_mark))
	waitmovement(0)
    delay(30)
    waitse
    playse(SE_EXIT)
    addobject(LOCALID_NIMBASACITY_ACE_TRAINER)
    waitse
    delay(20)
    msgbox("I won!\n"
            "Then I lost...", MSGBOX_DEFAULT, TRUE, LOCALID_NIMBASACITY_ACE_TRAINER)
    destroy_speech_bubble()
    closemessage
	getplayerxy (VAR_TEMP_0, VAR_TEMP_1)
	call_if_eq (VAR_TEMP_0, 45, NimbasaCity_EventScript_GiveVSRecorder_Pos1)
	call_if_eq (VAR_TEMP_0, 46, NimbasaCity_EventScript_GiveVSRecorder_Pos2)
	call_if_eq (VAR_TEMP_0, 47, NimbasaCity_EventScript_GiveVSRecorder_Pos3)
    applymovement(LOCALID_NIMBASACITY_ACE_TRAINER, moves(walk_down, walk_in_place_up))
    waitmovement(0)
    delay(10)
    msgbox("Gear Station has trains where\n"
            "you can battle other Trainers.\l"
            "The Battle Subway!", MSGBOX_DEFAULT, TRUE, LOCALID_NIMBASACITY_ACE_TRAINER)
    destroy_speech_bubble()
    closemessage
	getplayerxy (VAR_TEMP_0, VAR_TEMP_1)
	call_if_eq (VAR_TEMP_0, 45, NimbasaCity_EventScript_GiveVSRecorder_Pos4)
	call_if_eq (VAR_TEMP_0, 47, NimbasaCity_EventScript_GiveVSRecorder_Pos5)
    delay(10)
    msgbox("You're a Trainer, aren't you?\n"
            "Please just accept this without a word!", MSGBOX_DEFAULT, TRUE, LOCALID_NIMBASACITY_ACE_TRAINER)
    destroy_speech_bubble()
    closemessage
	showlargeitempic(8, 10, 3)
    playbgm (MUS_BW_OBTAIN_KEY_ITEM, TRUE)
    msgbox("{PLAYER} obtained the {SHADOW BLUE}{COLOR LIGHT_BLUE}Vs. Recorder{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}!", MSGBOX_TRANSPARENT)
    delay(120)
	additem (ITEM_VS_RECORDER)
	hidelargeitempic
    closemessage
	fadedefaultbgm
	savebgm(MUS_NIMBASA_CITY)
	delay(10)
    msgbox("If you have a Vs. Recorder, you can\n"
            "record battles with friends or on the\l"
            "Battle Subway!\p"
            "Anyway, this woman of mystery will\n"
            "go somewhere... That's right!\l"
            "She'll go to the Battle Institute!", MSGBOX_DEFAULT, TRUE, LOCALID_NIMBASACITY_ACE_TRAINER)
    destroy_speech_bubble()
    closemessage
	delay(10)
	applymovement(LOCALID_NIMBASACITY_ACE_TRAINER, moves(walk_down * 6))
	waitmovement(0)
    removeobject(LOCALID_NIMBASACITY_ACE_TRAINER)
    setvar(VAR_VS_RECORDER, 1)
	delay(20)
    release 
    end 
}

script NimbasaCity_EventScript_GiveVSRecorder_Pos1
{
	applymovement(LOCALID_PLAYER, moves(face_right))
	waitmovement(0)
    return
}

script NimbasaCity_EventScript_GiveVSRecorder_Pos2
{
	applymovement(LOCALID_PLAYER, moves(face_right, lock_facing_direction, walk_left, unlock_facing_direction))
	waitmovement(0)
    return
}

script NimbasaCity_EventScript_GiveVSRecorder_Pos3
{
	applymovement(LOCALID_PLAYER, moves(face_left))
	waitmovement(0)
    return
}

script NimbasaCity_EventScript_GiveVSRecorder_Pos4
{
	applymovement(LOCALID_NIMBASACITY_ACE_TRAINER, moves(walk_in_place_left))
	waitmovement(0)
    return
}

script NimbasaCity_EventScript_GiveVSRecorder_Pos5
{
	applymovement(LOCALID_NIMBASACITY_ACE_TRAINER, moves(walk_in_place_right))
	waitmovement(0)
    return
}
