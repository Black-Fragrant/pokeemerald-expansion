mapscripts NimbasaCity_MapScripts 
{
    MAP_SCRIPT_ON_TRANSITION : NimbasaCity_On_Transition
	MAP_SCRIPT_ON_FRAME_TABLE
    [
        VAR_NIMBASA_STATE, 2 : NimbasaCity_EventScript_Confrontation
    ]
}

script NimbasaCity_On_Transition
{
    setflag(FLAG_NIMBASA_CITY_SMALL_COURT_GAME_ONGOING)
    setflag(FLAG_NIMBASA_CITY_BIG_STADIUM_GAME_ONGOING)
	dotimebasedevents
	call_if_unset(FLAG_DAILY_RESET_STADIUM_TRAINER, NimbasaCity_EventScript_ResetStadiumTrainerFlags)
    callnative(DebugMenu_CalculateTime)
    callnative(DebugMenu_CalculateTimeOfDay)
	call_if_eq(VAR_DAY_OF_WEEK, 0, NimbasaCity_EventScript_Sunday)
	call_if_eq(VAR_DAY_OF_WEEK, 1, NimbasaCity_EventScript_Monday)
	call_if_eq(VAR_DAY_OF_WEEK, 2, NimbasaCity_EventScript_Tuesday)
	call_if_eq(VAR_DAY_OF_WEEK, 3, NimbasaCity_EventScript_Wednesday)
	call_if_eq(VAR_DAY_OF_WEEK, 4, NimbasaCity_EventScript_Thursday)
	call_if_eq(VAR_DAY_OF_WEEK, 5, NimbasaCity_EventScript_Friday)
	call_if_eq(VAR_DAY_OF_WEEK, 6, NimbasaCity_EventScript_Saturday)
    end
}

script NimbasaCity_EventScript_Sunday
{
	call_if_eq(VAR_TIME_OF_DAY, 10, NimbasaCity_EventScript_CourtGameActive)
	call_if_eq(VAR_TIME_OF_DAY, 14, NimbasaCity_EventScript_StadiumGameActive)
	call_if_eq(VAR_TIME_OF_DAY, 15, NimbasaCity_EventScript_StadiumGameActive)
	call_if_eq(VAR_TIME_OF_DAY, 16, NimbasaCity_EventScript_StadiumGameActive)
    return
}

script NimbasaCity_EventScript_Monday
{
	call_if_eq(VAR_TIME_OF_DAY, 10, NimbasaCity_EventScript_CourtGameActive)
	call_if_eq(VAR_TIME_OF_DAY, 14, NimbasaCity_EventScript_StadiumGameActive)
	call_if_eq(VAR_TIME_OF_DAY, 15, NimbasaCity_EventScript_StadiumGameActive)
	call_if_eq(VAR_TIME_OF_DAY, 16, NimbasaCity_EventScript_StadiumGameActive)
    return
}

