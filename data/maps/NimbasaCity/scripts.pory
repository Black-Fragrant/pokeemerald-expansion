script NimbasaCity_EventScript_BiancaStopsPlayer
{
    lock
    msgbox("Bianca: Yoo-hoo, {PLAYER}!", MSGBOX_DEFAULT, FALSE)
    closemessage
	playbgm(MUS_BW_BIANCA, TRUE)
    addobject(LOCALID_NIMBASACITY_BIANCA_TOPLEFT)
	applymovement(LOCALID_PLAYER, moves(walk_in_place_right))
	waitmovement(0)
	getplayerxy (VAR_TEMP_0, VAR_TEMP_1)
	call_if_eq (VAR_TEMP_1, 14, NimbasaCity_EventScript_BSP_Pos1)
	call_if_eq (VAR_TEMP_1, 15, NimbasaCity_EventScript_BSP_Pos2)
	call_if_eq (VAR_TEMP_1, 16, NimbasaCity_EventScript_BSP_Pos3)
	call_if_eq (VAR_TEMP_1, 17, NimbasaCity_EventScript_BSP_Pos4)
	call_if_eq (VAR_TEMP_1, 18, NimbasaCity_EventScript_BSP_Pos5)
    delay(10)
    msgbox("I just had a look at the Musical Theater.\n"
        "It's sooo cool!\p"
        "Since you're here, come on, {PLAYER}!\p"
        "Come with me!\n"
        "Over here, over here!", MSGBOX_DEFAULT, TRUE, LOCALID_NIMBASACITY_BIANCA_TOPLEFT)
    destroy_speech_bubble()
    closemessage
    setflag(FLAG_NIMBASA_CITY_BIANCA_BLOCKING_THEATER)
	call_if_eq (VAR_TEMP_1, 14, NimbasaCity_EventScript_BSP_Pos6)
	call_if_eq (VAR_TEMP_1, 15, NimbasaCity_EventScript_BSP_Pos7)
	call_if_eq (VAR_TEMP_1, 16, NimbasaCity_EventScript_BSP_Pos8)
	call_if_eq (VAR_TEMP_1, 17, NimbasaCity_EventScript_BSP_Pos9)
	call_if_eq (VAR_TEMP_1, 18, NimbasaCity_EventScript_BSP_Pos10)
    delay(10)
    msgbox("OK, we're here! Let's go in!", MSGBOX_DEFAULT, TRUE, LOCALID_NIMBASACITY_BIANCA_TOPLEFT)
    destroy_speech_bubble()
    closemessage
	applymovement(LOCALID_NIMBASACITY_BIANCA_TOPLEFT, moves(walk_in_place_up, delay_16))
	waitmovement(0)
	applymovement(LOCALID_NIMBASACITY_BIANCA_TOPLEFT, moves(walk_up))
	applymovement(LOCALID_PLAYER, moves(walk_up))
	waitmovement(0)
    playse(SE_EXIT)
    removeobject(LOCALID_NIMBASACITY_BIANCA_TOPLEFT)
    waitse
    delay(20)
	applymovement(LOCALID_PLAYER, moves(walk_up))
	waitmovement(0)
    warp(MAP_NIMBASA_CITY_MUSICAL_THEATER, 14, 23)
    waitstate
    end
}

