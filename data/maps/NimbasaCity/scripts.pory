script NimbasaCity_EventScript_BiancaBlockingMusicalTheater
{
    lock
    faceplayer
    msgbox("Bianca: Ooh, {PLAYER}!\p"
        "Are you interested in musicals?\n"
        "Then, let's go in together!", MSGBOX_DEFAULT, TRUE, LOCALID_NIMBASACITY_BIANCA_BLOCKING)
    destroy_speech_bubble()
    closemessage
	applymovement(LOCALID_NIMBASACITY_BIANCA_BLOCKING, moves(walk_in_place_up, delay_16))
	waitmovement(0)
	getplayerxy (VAR_TEMP_0, VAR_TEMP_1)
	call_if_eq (VAR_TEMP_0, 56, NimbasaCity_EventScript_BBMT_Pos1)
	call_if_eq (VAR_TEMP_0, 57, NimbasaCity_EventScript_BBMT_Pos2)
	call_if_eq (VAR_TEMP_0, 58, NimbasaCity_EventScript_BBMT_Pos3)
    playse(SE_EXIT)
    removeobject(LOCALID_NIMBASACITY_BIANCA_BLOCKING)
    waitse
    delay(20)
	applymovement(LOCALID_PLAYER, moves(walk_up))
	waitmovement(0)
    warp(MAP_NIMBASA_CITY_MUSICAL_THEATER, 14, 23)
    waitstate
    end
}

