mapscripts Platform_SuperSingleTrain_MapScripts {}


script Platform_SuperSingleTrain_EventScript_Trigger
{
    lock
    call(BattleSubway_EventScript_Platform_StopPlayerAtConductor)
    applymovement(LOCALID_SUPERSINGLETRAIN_AGENT, Common_Movement_FacePlayer)
    waitmovement(0)
	setvar(VAR_FRONTIER_FACILITY, FRONTIER_FACILITY_TOWER) 
	special(SavePlayerParty)
	msgbox("Welcome to the Battle Subway!\p"
            "I'm sorry, but this Super Single Train\n"
            "isn't ready yet.", MSGBOX_DEFAULT, TRUE, LOCALID_SUPERSINGLETRAIN_AGENT)
    destroy_speech_bubble()
    goto(Platform_SuperSingleTrain_EventScript_Cancel)
}

script Platform_SuperSingleTrain_EventScript_Cancel
{
	msgbox(BattleSubway_Text_WeHopeToSeeYouAgain, MSGBOX_DEFAULT, TRUE, LOCALID_SUPERSINGLETRAIN_AGENT)
    destroy_speech_bubble()
    closemessage
    call(BattleSubway_EventScript_Platform_ForcePlayerWalkLeftUponCancel)
	applymovement(LOCALID_SUPERSINGLETRAIN_AGENT, Common_Movement_FaceLeft)
	waitmovement(0)
	release
	end
}
