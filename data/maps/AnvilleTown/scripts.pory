mapscripts AnvilleTown_MapScripts 
{
    MAP_SCRIPT_ON_TRANSITION : AnvilleTown_On_Transition
        MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE
    [
        VAR_BATTLE_SUBWAY_BOARDING, CHALLENGE_STATUS_RETURN : AnvilleTown_EventScript_TurnPlayer
    ]
}

script AnvilleTown_On_Transition
{
    setflag(FLAG_TEMP_11)
    callnative(DebugMenu_CalculateTime)
	call_if_eq(VAR_DAY_OF_WEEK, 0, AnvilleTown_EventScript_Weekend)
	call_if_eq(VAR_DAY_OF_WEEK, 6, AnvilleTown_EventScript_Weekend)
	end()
}

script AnvilleTown_EventScript_Weekend
{
    clearflag(FLAG_TEMP_11)
    return
}

script AnvilleTown_EventScript_TurnPlayer
{
	turnobject (LOCALID_PLAYER, DIR_WEST)
    setvar(VAR_BATTLE_SUBWAY_BOARDING, 0)
	end()
}

script AnvilleTown_EventScript_Conductor
{
	lock
    faceplayer
    msgbox("A train to Nimbasa City is leaving\n"
        "the station shortly.\p"
        "Would you like to board?", MSGBOX_YESNO, TRUE, LOCALID_ANVILLETOWN_CONDUCTOR)
    goto_if_eq(VAR_RESULT, YES, AnvilleTown_EventScript_BoardTheTrain)
    msgbox("This is a quiet town!\n"
            "Relax and stay for a while.", MSGBOX_DEFAULT, FALSE, LOCALID_ANVILLETOWN_CONDUCTOR)
    destroy_speech_bubble()
    closemessage
    release
    end
}

script AnvilleTown_EventScript_BoardTheTrain
{
    msgbox("Then, please get on the train and wait.", MSGBOX_DEFAULT, FALSE, LOCALID_ANVILLETOWN_CONDUCTOR)
    destroy_speech_bubble()
    closemessage
	getplayerxy (VAR_TEMP_0, VAR_TEMP_1)
	call_if_eq (VAR_TEMP_1, 41, AnvilleTown_EventScript_BTT_Pos1)
	call_if_eq (VAR_TEMP_1, 42, AnvilleTown_EventScript_BTT_Pos2)
	call_if_eq (VAR_TEMP_1, 43, AnvilleTown_EventScript_BTT_Pos3)
    applymovement(LOCALID_ANVILLETOWN_CONDUCTOR, moves(walk_in_place_down))
    applymovement(LOCALID_PLAYER, moves(delay_16, set_invisible))
    waitmovement(0)
    playse(SE_EXIT)
    waitse
    setvar(VAR_BATTLE_SUBWAY_BOARDING, CHALLENGE_STATUS_RETURN)
	fadescreen(FADE_TO_BLACK)
	warpsilent(MAP_PLATFORM_TRAIN_TO_ANVILLE_TOWN, 21, 9)
	waitstate
	end
}

script AnvilleTown_EventScript_BTT_Pos1
{
    applymovement(LOCALID_PLAYER, moves(walk_left, walk_down * 3, walk_right))
    waitmovement(0)
    return
}

script AnvilleTown_EventScript_BTT_Pos2
{
    applymovement(LOCALID_PLAYER, moves(walk_down * 2, walk_right))
    waitmovement(0)
    return
}

script AnvilleTown_EventScript_BTT_Pos3
{
    applymovement(LOCALID_PLAYER, moves(walk_down, walk_in_place_right))
    waitmovement(0)
    return
}

script AnvilleTown_EventScript_Sign
{
    msgbox("Anville Town\n"
       "Rolling Out the Steel Rails", MSGBOX_SIGN)
    end()
}

script AnvilleTown_EventScript_FlutePlayer
{
    lock
    msgbox("A beautiful tune is spreading\n"
            "throughout the town...", MSGBOX_DEFAULT, FALSE)
    closemessage
    release
    end()
}

script AnvilleTown_EventScript_MineWorker
{
    lock
    faceplayer
	special(SpawnCameraObject)
	applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_up))
	waitmovement(0)
	special(RemoveCameraObject)
    msgbox("Oh, are you also curious about\n"
            "that train?", MSGBOX_YESNO, TRUE, LOCALID_ANVILLETOWN_WORKER)
    goto_if_eq(VAR_RESULT, YES, AnvilleTown_EventScript_ExplainTrains)
    msgbox("Oh, that's a shame.", MSGBOX_DEFAULT, FALSE, LOCALID_ANVILLETOWN_WORKER)
    goto(AnvilleTown_EventScript_FinishExplaining)
}

script AnvilleTown_EventScript_DepotAgent
{
    msgbox("A lot of train cars have a rest here.", MSGBOX_NPC, TRUE)
    end()
}

script AnvilleTown_EventScript_Richboy
{
    msgbox("That girl on the bridge...\p"
        "She's playing a lullaby for all the\n"
        "sleeping trains of this town.", MSGBOX_NPC, TRUE)
    end()
}

script AnvilleTown_EventScript_Grandpa
{
    msgbox("On weekends, a lot of people come here\n"
        "to watch the trains.", MSGBOX_NPC, TRUE)
    end()
}

script AnvilleTown_EventScript_CheerleaderMan
{
    msgbox("On weekends, a lot of people come here\n"
        "to watch the trains.", MSGBOX_NPC, TRUE)
    end()
}

script AnvilleTown_EventScript_Hiker
{
    msgbox("What delicious air!", MSGBOX_NPC, TRUE)
    end()
}

script AnvilleTown_EventScript_Beauty
{
    msgbox("You can trade lots of items.\n"
        "It was surprisingly fun when I tried!", MSGBOX_NPC, TRUE)
    end()
}

script AnvilleTown_EventScript_SchoolBoy
{
    lock
    faceplayer
    msgbox("Trains are so cooooool!\p"
        "My mom brought me, but now she's\n"
        "taking pictures somewhere.", MSGBOX_DEFAULT, TRUE, VAR_LAST_TALKED)
    destroy_speech_bubble()
    closemessage
    applymovement(VAR_LAST_TALKED, moves(walk_in_place_up))
    waitmovement(0)
    end()
}

script AnvilleTown_EventScript_Girl
{
    msgbox("Why do people love trains?\p"
        "Maybe it's the design, the way they can\n"
        "run so fast and still be so comfortable.\p"
        "All the essential parts work together...\n"
        "It's simple but so beautiful!", MSGBOX_NPC, TRUE)
    end()
}

script AnvilleTown_EventScript_Housewife
{
    lock
    faceplayer
    msgbox("I wanted to get a picture from\n"
        "this angle!", MSGBOX_DEFAULT, TRUE, VAR_LAST_TALKED)
    destroy_speech_bubble()
    closemessage
    applymovement(VAR_LAST_TALKED, moves(walk_in_place_left))
    waitmovement(0)
    end()
}

script AnvilleTown_EventScript_Backpacker
{
    lock
    faceplayer
    goto_if_set(FLAG_TEMP_12, AnvilleTown_EventScript_Backpacker_Ask)
    msgbox("Ah... I'm in trouble.\p"
        "I was so engrossed in my trip that I ran\n"
        "out of Escape Ropes.\p"
        "Let me see...", MSGBOX_DEFAULT, TRUE, VAR_LAST_TALKED)
    destroy_speech_bubble()
    closemessage
    setflag(FLAG_TEMP_12)
    msgbox(AnvilleTown_Text_BackpackerQuestion, MSGBOX_YESNO, FALSE, VAR_LAST_TALKED)
    goto(AnvilleTown_EventScript_Backpacker_Cont)
}

script AnvilleTown_EventScript_Backpacker_Ask
{
    msgbox(AnvilleTown_Text_BackpackerQuestion, MSGBOX_YESNO, TRUE, VAR_LAST_TALKED)
    goto(AnvilleTown_EventScript_Backpacker_Cont)
}

script AnvilleTown_EventScript_Backpacker_Cont
{
    goto_if_eq(VAR_RESULT, YES, AnvilleTown_EventScript_Backpacker_Trade)
    msgbox("Oh, that's a shame.", MSGBOX_DEFAULT, FALSE, VAR_LAST_TALKED)
    destroy_speech_bubble()
    closemessage
    release
    end
}

script AnvilleTown_EventScript_Backpacker_NotEnough
{
    msgbox("...Uh-oh. You don't have\n"
        "enough Escape Ropes.", MSGBOX_DEFAULT, FALSE, VAR_LAST_TALKED)
    destroy_speech_bubble()
    closemessage
    release
    end
}

script AnvilleTown_EventScript_Backpacker_Trade
{
	checkitem(ITEM_ESCAPE_ROPE, 2)
	goto_if_eq(VAR_RESULT, FALSE, AnvilleTown_EventScript_Backpacker_NotEnough)
    msgbox("Great, let's trade!", MSGBOX_DEFAULT, FALSE, VAR_LAST_TALKED)
    destroy_speech_bubble()
    closemessage
	playfanfare(MUS_OBTAIN_ITEM)
    msgbox("Gave the Escape Ropes in exchange for\n"
           "the Revive!", MSGBOX_TRANSPARENT)
    waitmessage
	waitfanfare
    closemessage
	removeitem(ITEM_ESCAPE_ROPE, 2)
    additem(ITEM_REVIVE, 1)
    msgbox("Hehe! It was a delightful trade,\n"
        "wasn't it?", MSGBOX_DEFAULT, TRUE, VAR_LAST_TALKED)
    destroy_speech_bubble()
    closemessage
    release
    end
}

script AnvilleTown_EventScript_Clerk
{
    lock
    faceplayer
    goto_if_set(FLAG_TEMP_13, AnvilleTown_EventScript_Clerk_Ask)
    msgbox("I am a Star Piece collector!\p"
       "You, over there! Let's have a\n"
       "businesslike exchange.", MSGBOX_DEFAULT, TRUE, VAR_LAST_TALKED)
    destroy_speech_bubble()
    closemessage
    setflag(FLAG_TEMP_13)
    msgbox(AnvilleTown_Text_ClerkQuestion, MSGBOX_YESNO, FALSE, VAR_LAST_TALKED)
    goto(AnvilleTown_EventScript_Clerk_Cont)
}

script AnvilleTown_EventScript_Clerk_Ask
{
    msgbox(AnvilleTown_Text_ClerkQuestion, MSGBOX_YESNO, TRUE, VAR_LAST_TALKED)
    goto(AnvilleTown_EventScript_Clerk_Cont)
}

script AnvilleTown_EventScript_Clerk_Cont
{
    goto_if_eq(VAR_RESULT, YES, AnvilleTown_EventScript_Clerk_Trade)
    msgbox("Why? Do you think this is a bad deal?", MSGBOX_DEFAULT, FALSE, VAR_LAST_TALKED)
    destroy_speech_bubble()
    closemessage
    release
    end
}

script AnvilleTown_EventScript_Clerk_NotEnough
{
    msgbox("Hah! You don't have\n"
            "any Star Pieces.", MSGBOX_DEFAULT, FALSE, VAR_LAST_TALKED)
    destroy_speech_bubble()
    closemessage
    release
    end
}

script AnvilleTown_EventScript_Clerk_Trade
{
	checkitem(ITEM_STAR_PIECE, 1)
	goto_if_eq(VAR_RESULT, FALSE, AnvilleTown_EventScript_Clerk_NotEnough)
    msgbox("Excellent. Let's do business!", MSGBOX_DEFAULT, FALSE, VAR_LAST_TALKED)
    destroy_speech_bubble()
    closemessage
	playfanfare(MUS_OBTAIN_ITEM)
    msgbox("Gave the Star Piece in exchange for\n"
           "the PP Up!", MSGBOX_TRANSPARENT)
    waitmessage
	waitfanfare
    closemessage
	removeitem(ITEM_STAR_PIECE, 1)
    additem(ITEM_PP_UP, 1)
    msgbox("Hah! It was a mutually beneficial trade!\n"
        "This is a win-win relationship, right?", MSGBOX_DEFAULT, TRUE, VAR_LAST_TALKED)
    destroy_speech_bubble()
    closemessage
    release
    end
}

script AnvilleTown_EventScript_AceTrainer
{
    lock
    faceplayer
    goto_if_set(FLAG_TEMP_14, AnvilleTown_EventScript_AceTrainer_Ask)
    msgbox("With that face, I bet you have\n"
       "something I want.", MSGBOX_DEFAULT, TRUE, VAR_LAST_TALKED)
    destroy_speech_bubble()
    closemessage
    setflag(FLAG_TEMP_14)
    msgbox(AnvilleTown_Text_AceTrainerQuestion, MSGBOX_YESNO, FALSE, VAR_LAST_TALKED)
    goto(AnvilleTown_EventScript_AceTrainer_Cont)
}

script AnvilleTown_EventScript_AceTrainer_Ask
{
    msgbox(AnvilleTown_Text_AceTrainerQuestion, MSGBOX_YESNO, TRUE, VAR_LAST_TALKED)
    goto(AnvilleTown_EventScript_AceTrainer_Cont)
}

script AnvilleTown_EventScript_AceTrainer_Cont
{
    goto_if_eq(VAR_RESULT, YES, AnvilleTown_EventScript_AceTrainer_Trade)
    msgbox("Oh, it seems I was mistaken...", MSGBOX_DEFAULT, FALSE, VAR_LAST_TALKED)
    destroy_speech_bubble()
    closemessage
    release
    end
}

script AnvilleTown_EventScript_AceTrainer_NotEnough
{
    msgbox("Ooh-la-la!\n"
            "You don't have enough Poké Balls.", MSGBOX_DEFAULT, FALSE, VAR_LAST_TALKED)
    destroy_speech_bubble()
    closemessage
    release
    end
}

script AnvilleTown_EventScript_AceTrainer_Trade
{
	checkitem(ITEM_POKE_BALL, 20)
	goto_if_eq(VAR_RESULT, FALSE, AnvilleTown_EventScript_AceTrainer_NotEnough)
    msgbox("Yay!\n"
            "Then, let's trade!", MSGBOX_DEFAULT, FALSE, VAR_LAST_TALKED)
    destroy_speech_bubble()
    closemessage
	playfanfare(MUS_OBTAIN_ITEM)
    msgbox("Gave the Poké Balls in exchange for\n"
           "the Full Restore!", MSGBOX_TRANSPARENT)
    waitmessage
	waitfanfare
    closemessage
	removeitem(ITEM_POKE_BALL, 20)
    additem(ITEM_FULL_RESTORE, 1)
    msgbox("Ooh-la-la! This luster!\n"
        "I really like Poké Balls.", MSGBOX_DEFAULT, TRUE, VAR_LAST_TALKED)
    destroy_speech_bubble()
    closemessage
    release
    end
}

