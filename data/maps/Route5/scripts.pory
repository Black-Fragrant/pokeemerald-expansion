mapscripts Route5_MapScripts 
{
		MAP_SCRIPT_ON_TRANSITION : Route5_On_Transition
}

script Route5_On_Transition
{
	call_if_eq(VAR_ROUTE_5_STATE, 1, Route5_EventScript_HideNPCs)
	call_if_eq(VAR_ROUTE_5_STATE, 255, Route5_EventScript_PositionAlder)
	end
}

script Route5_EventScript_HideNPCs
{
	setflag(FLAG_TEMP_11)
	return
}

script Route5_EventScript_PositionAlder
{
	setobjectxyperm (LOCALID_ROUTE5_ALDER, 35, 18)
	setobjectxyperm (LOCALID_ROUTE5_PRESCHOOLERF, 36, 18)
	setobjectxyperm (LOCALID_ROUTE5_PRESCHOOLERM, 37, 18)
    setobjectmovementtype (LOCALID_ROUTE5_ALDER, MOVEMENT_TYPE_FACE_DOWN)
    setobjectmovementtype (LOCALID_ROUTE5_PRESCHOOLERF, MOVEMENT_TYPE_FACE_DOWN)
    setobjectmovementtype (LOCALID_ROUTE5_PRESCHOOLERM, MOVEMENT_TYPE_FACE_DOWN)
	return
}

script Route5_EventScript_RouteSign
{
    msgbox("Route 5\n"
        "Performer Street", MSGBOX_SIGN)
    end
}

script Route5_EventScript_TrainerTips
{
    msgbox("Trainer Tips!\p"
        "There are different Cases\n"
        "for each type of item.\p"
        "Items are placed automatically in\n"
        "the correct Case by their type.\p"
        "The name of the Case tells you\n"
        "what type of items will be kept there.", MSGBOX_SIGN)
    end
}

script Route5_EventScript_BridgeSign
{
    msgbox("Driftveil Drawbridge", MSGBOX_SIGN)
    end
}

script Route5_EventScript_Battle_Baker
{
	trainerbattle_single(TRAINER_BAKER_ROUTE_5,
	text("These Pokémon usually help me bake.\n"
        "Today, they'll help me battle you!"),
	text("Oh, my...\n"
        "It was a tasty battle."))
	msgbox("I get on well with my Pokémon, and we\n"
        "bake bread together. It's so much fun!\l"
        "I don't mind getting up early every day.", MSGBOX_NPC, TRUE)
	end()
}

script Route5_EventScript_Battle_Harlequin
{
	trainerbattle_single(TRAINER_HARLEQUIN_ROUTE_5,
	text("I will show you all the moves\n"
        "that my Pokémon have mastered!"),
	text("I am sorry that I underestimated\n"
        "you and your Pokémon's moves!"))
	msgbox("Sometimes a battle is so beautiful\n"
        "that it takes your breath away.\p"
        "Ours was such a battle!", MSGBOX_NPC, TRUE)
	end()
}

script Route5_EventScript_Battle_Musician
{
	trainerbattle_single(TRAINER_MUCISIAN_ROUTE_5,
	text("I will show you all the moves\n"
        "that my Pokémon have mastered!"),
	text("There's a rhythm to attacking\n"
        "and defending...\l"
        "I think ours got thrown off."),
	Route5_EventScript_Battle_Musician_GivesMetronome)
	goto(Route5_EventScript_Battle_Musician_GivesMetronome)
	end()
}

script Route5_EventScript_Battle_Musician_GivesMetronome
{
    setobjectmovementtype (LOCALID_ROUTE5_MUSICIAN, MOVEMENT_TYPE_WALK_SLOWLY_IN_PLACE_DOWN)
	goto_if_set(FLAG_ROUTE5_ITEM_METRONOME, Route5_EventScript_Battle_Musician_Received)
	msgbox("In battling you, I came to understand...\p"
        "You're the best!\n"
        "Here! This is for you!", MSGBOX_DEFAULT, TRUE, LOCALID_ROUTE5_MUSICIAN)
	destroy_speech_bubble()
	closemessage
	giveitem(ITEM_METRONOME, 1)
	goto_if_eq (VAR_RESULT, FALSE, Common_EventScript_BagIsFull_EndScript)
	goto (Route5_EventScript_Battle_Musician_Received)
	end
}

script Route5_EventScript_Battle_Musician_Received
{
	msgbox("If you want your Pokémon to\n"
        "hold an Electric Guitar like me,\l"
        "go to the Musical Theater!\l"
        "Cooler than cool!", MSGBOX_DEFAULT, TRUE, LOCALID_ROUTE5_MUSICIAN)
	destroy_speech_bubble()
	closemessage
	setflag(FLAG_ROUTE5_ITEM_METRONOME)
	release()
	end()
}

script Route5_EventScript_Battle_Dancer
{
	trainerbattle_single(TRAINER_DANCER_ROUTE_5,
	text("Turn around, and it's my turn. {EMOJI_NOTE}\n"
        "Turn around, and it's your turn."),
	text("Turn around, turn around, turn around..."))
	msgbox("It's difficult to have a battle while\n"
        "tapping my toes.\p"
        "But I am a Dancer!\n"
        "It is natural to dance!", MSGBOX_NPC, TRUE)
	end()
}

script Route5_EventScript_Battle_Artist
{
	trainerbattle_single(TRAINER_ARTIST_ROUTE_5,
	text("Hi, Trainer!\n"
        "Let me turn you into a work of art!"),
	text("Oh, I just got whitewashed!"))
	msgbox("The reason why there are so many colors\n"
        "in this world...white, black, red, green,\l"
        "blue, yellow...is that they can be mixed\l"
        "to create an explosion of new color!\p"
        "Boom!", MSGBOX_NPC, TRUE)
	end()
}

script Route5_EventScript_Battle_BackpackerF
{
	trainerbattle_single(TRAINER_BACKPACKER_F_ROUTE_5,
	text("The big bag...\n"
        "What do you think is inside?"),
	text("I lost, but now I have more things\n"
        "to add to my bag."))
	msgbox("I'll tell you a secret. The things I put\n"
        "in the bag are memories of my journey!\p"
        "The things you can't see are very heavy!", MSGBOX_NPC, TRUE)
	end()
}

script Route5_EventScript_Battle_BackpackerM
{
	trainerbattle_single(TRAINER_BACKPACKER_M_ROUTE_5,
	text("As my mind roams, as the wind blows,\n"
        "destiny has brought us to this battle."),
	text("Urgh... I didn't know\n"
        "I was flying against the wind..."))
	msgbox("I want to fly around the Unova region,\n"
        "blown by the wind!", MSGBOX_NPC, TRUE)
	end()
}

script Route5_EventScript_AudienceLeft
{
	msgbox("The Pokémon and the performers\n"
        "all have amazing moves!", MSGBOX_NPC, TRUE)
	end
}

script Route5_EventScript_AudienceMiddle
{
	msgbox("The street performers are my favorites.\n"
        "They're so charming!", MSGBOX_NPC, TRUE)
	end
}

script Route5_EventScript_AudienceRight
{
	msgbox("I think being able to make people\n"
        "smile is a super-awesome talent!\p"
        "That's why Pokémon are so awesome!\n"
        "Because they can make you smile!", MSGBOX_NPC, TRUE)
	end
}

script Route5_EventScript_Alder
{
	msgbox("Alder: It's tremendous that people and\n"
       "Pokémon, each so different, can\l"
       "acknowledge each other and be together!", MSGBOX_NPC, TRUE)
	end
}

script Route5_EventScript_PreschoolerM
{
	msgbox("Alder is so strong!\n"
       "And he's nice to Pokémon!", MSGBOX_NPC, TRUE)
	end
}

script Route5_EventScript_PreschoolerF
{
	msgbox("I was scared of Pokémon, but Alder\n"
       "taught me that they're nice and friendly.", MSGBOX_NPC, TRUE)
	end
}

script Route5_EventScript_GateOperator
{
	lock
	faceplayer
	call(Route5_EventScript_GateOperator_Dialogue)
	release
	end
}

script Route5_EventScript_GateOperator_Dialogue
{
	msgbox("The drawbridge is raised right now\n"
        "so ships can pass. You can't cross.\p"
        "If you make a request to Drifveil's Gym\n"
        "Leader, Clay, he could... Well, I'm not\l"
        "sure how you'd reach him over there...\p"
        "If you talk to Nimbasa City's Gym Leader,\n"
        "Elesa, she might be able to do something.", MSGBOX_DEFAULT, TRUE, LOCALID_ROUTE5_GATE_OPERATOR)
	destroy_speech_bubble()
	closemessage
	return
}

script Route5_EventScript_Trigger
{
	lock
	msgbox("Excuse me!\n"
        "Please stop right there!", MSGBOX_DEFAULT)
	closemessage
	getplayerxy (VAR_TEMP_0, VAR_TEMP_1)
	call_if_eq (VAR_TEMP_1, 14, Route5_EventScript_Trigger_Pos1)
	call_if_eq (VAR_TEMP_1, 15, Route5_EventScript_Trigger_Pos1)
	call_if_eq (VAR_TEMP_1, 16, Route5_EventScript_Trigger_Pos2)
	call_if_eq (VAR_TEMP_1, 17, Route5_EventScript_Trigger_Pos3)
	call_if_eq (VAR_TEMP_1, 14, Route5_EventScript_Trigger_Cam1)
	call_if_eq (VAR_TEMP_1, 15, Route5_EventScript_Trigger_Cam2)
	call_if_eq (VAR_TEMP_1, 16, Route5_EventScript_Trigger_Cam2)
	call_if_eq (VAR_TEMP_1, 17, Route5_EventScript_Trigger_Cam2)
	call(Route5_EventScript_GateOperator_Dialogue)
	call_if_eq (VAR_TEMP_1, 14, Route5_EventScript_Trigger_Cam3)
	call_if_eq (VAR_TEMP_1, 15, Route5_EventScript_Trigger_Cam4)
	call_if_eq (VAR_TEMP_1, 16, Route5_EventScript_Trigger_Cam4)
	call_if_eq (VAR_TEMP_1, 17, Route5_EventScript_Trigger_Cam4)
	release
	end
}

script Route5_EventScript_Trigger_Pos1
{
	applymovement(LOCALID_PLAYER, moves(walk_right, walk_in_place_up))
	waitmovement(0)
	return
}

script Route5_EventScript_Trigger_Pos2
{
	applymovement(LOCALID_PLAYER, moves(walk_right, walk_up))
	waitmovement(0)
	return
}

script Route5_EventScript_Trigger_Pos3
{
	applymovement(LOCALID_PLAYER, moves(walk_right, walk_up * 2))
	waitmovement(0)
	return
}

script Route5_EventScript_Trigger_Cam1
{
	special(SpawnCameraObject)
	applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_up * 1))
	waitmovement(0)
	special(RemoveCameraObject)
	return
}

script Route5_EventScript_Trigger_Cam2
{
	special(SpawnCameraObject)
	applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_up * 2))
	waitmovement(0)
	special(RemoveCameraObject)
	return
}

script Route5_EventScript_Trigger_Cam3
{
	special(SpawnCameraObject)
	applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_down * 1))
	waitmovement(0)
	special(RemoveCameraObject)
	return
}

script Route5_EventScript_Trigger_Cam4
{
	special(SpawnCameraObject)
	applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_down * 2))
	waitmovement(0)
	special(RemoveCameraObject)
	return
}

script Route5_EventScript_Trigger_CherenBattle
{
	lock
	playbgm(MUS_BW_CHEREN, FALSE)
	playse(SE_EXIT)
	addobject(LOCALID_ROUTE5_CHEREN)
	waitse
	delay(20)
	getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
	call_if_eq(VAR_TEMP_1, 18, Route5_EventScript_TCB_Pos1)
	call_if_eq(VAR_TEMP_1, 19, Route5_EventScript_TCB_Pos2)
	call_if_eq(VAR_TEMP_1, 20, Route5_EventScript_TCB_Pos3)
	call_if_eq(VAR_TEMP_1, 21, Route5_EventScript_TCB_Pos4)
	call_if_eq(VAR_TEMP_1, 22, Route5_EventScript_TCB_Pos5)
	call_if_eq(VAR_TEMP_1, 23, Route5_EventScript_TCB_Pos6)
	delay(10)
	msgbox("Cheren: {PLAYER}, stop!\p"
		"You've got a Bolt Badge...\n"
		"I've got a Bolt Badge...\p"
		"Let's test who's stronger--you or me!\n"
		"This time, I'm going to win!", MSGBOX_DEFAULT, TRUE, LOCALID_ROUTE5_CHEREN)
	destroy_speech_bubble()
	closemessage
//	call_if_set(FLAG_CHOSE_SNIVY, Route5_EventScript_CB_Tepig)
//	call_if_set(FLAG_CHOSE_TEPIG, Route5_EventScript_CB_Oshawott)
//	call_if_set(FLAG_CHOSE_OSHAWOTT, Route5_EventScript_CB_Snivy)
	msgbox("Cheren: Why?\n"
		"Why can't I beat you?", MSGBOX_DEFAULT, TRUE, LOCALID_ROUTE5_CHEREN)
	destroy_speech_bubble()
	closemessage
	addobject(LOCALID_ROUTE5_ELESA)
	getplayerxy(VAR_TEMP_0, VAR_TEMP_1)
	call_if_eq(VAR_TEMP_1, 19, Route5_EventScript_TCB_Pos7)
	call_if_eq(VAR_TEMP_1, 20, Route5_EventScript_TCB_Pos8)
	call_if_eq(VAR_TEMP_1, 21, Route5_EventScript_TCB_Pos9)
	applymovement(LOCALID_PLAYER, moves(walk_in_place_left))
	waitmovement(0)
	delay(10)
	msgbox("Elesa: Oh, you two are friends...\p"
		"That's nice, how you're helping each\n"
		"other get better by competing.", MSGBOX_DEFAULT, TRUE, LOCALID_ROUTE5_ELESA)
	destroy_speech_bubble()
	closemessage
	applymovement(LOCALID_ROUTE5_ELESA, moves(walk_in_place_left))
	waitmovement(0)
	delay(10)
	msgbox("OK, let's go.", MSGBOX_DEFAULT, TRUE, LOCALID_ROUTE5_ELESA)
	destroy_speech_bubble()
	closemessage
	call_if_eq(VAR_TEMP_1, 19, Route5_EventScript_TCB_Pos10)
	call_if_eq(VAR_TEMP_1, 20, Route5_EventScript_TCB_Pos11)
	call_if_eq(VAR_TEMP_1, 21, Route5_EventScript_TCB_Pos12)
	playse(SE_PIN)
	applymovement(LOCALID_ROUTE5_ALDER, moves(emote_exclamation_mark))
	waitmovement(0)
	waitse()
	delay(20)
	applymovement(LOCALID_ROUTE5_ALDER, moves(walk_in_place_down))
	waitmovement(0)
	delay(10)
	msgbox("???: Oh!\n"
		"Why, if it isn't Elesa!", MSGBOX_DEFAULT, FALSE)
	closemessage
	playbgm(MUS_BW_ALDER, TRUE)
	delay(10)
	applymovement(LOCALID_ROUTE5_ELESA, moves(walk_in_place_up))
	applymovement(LOCALID_PLAYER, moves(walk_in_place_up))
	applymovement(LOCALID_ROUTE5_CHEREN, moves(walk_in_place_up))
	waitmovement(0)
	special(SpawnCameraObject)
	applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_up * 2))
	waitmovement(0)
	special(RemoveCameraObject)
	applymovement(LOCALID_ROUTE5_ALDER, moves(walk_down, walk_left * 2, walk_in_place_down))
	waitmovement(0)
	delay(10)
	msgbox("???: Aren't festivals grand?\n"
		"Life should be enjoyed!", MSGBOX_DEFAULT, TRUE, LOCALID_ROUTE5_ALDER)
	destroy_speech_bubble()
	closemessage
	applymovement(LOCALID_ROUTE5_CHEREN, moves(walk_in_place_left))
	waitmovement(0)
	delay(10)
	msgbox("Cheren: Who is this man?", MSGBOX_DEFAULT, TRUE, LOCALID_ROUTE5_CHEREN)
	destroy_speech_bubble()
	closemessage
	applymovement(LOCALID_ROUTE5_ELESA, moves(walk_in_place_right))
	waitmovement(0)
	delay(10)
	msgbox("Elesa: This is Alder,\n"
		"the Unova region's Champion.", MSGBOX_DEFAULT, TRUE, LOCALID_ROUTE5_ELESA)
	destroy_speech_bubble()
	closemessage
	msgbox("Cheren: Champion?!\p"
		"Why would the Champion be\n"
		"goofing off in a place like this?", MSGBOX_DEFAULT, TRUE, LOCALID_ROUTE5_CHEREN)
	destroy_speech_bubble()
	closemessage
	applymovement(LOCALID_ROUTE5_ALDER, moves(walk_right * 2, walk_in_place_down))
	waitmovement(0)
	applymovement(LOCALID_ROUTE5_CHEREN, moves(walk_in_place_up))
	waitmovement(0)
	delay(10)
	msgbox("Alder: I heard that remark.\n"
		"You're quite a judgmental young person,\l"
		"are you not?\p"
		"My name is Alder. I'm the Unova\n"
		"Pokémon League's Champion.\p"
		"Pleased to make your acquaintance.\p"
		"For your information, I'm not\n"
		"goofing off. I'm on a voyage.\l"
		"I know every corner of Unova.", MSGBOX_DEFAULT, TRUE, LOCALID_ROUTE5_ALDER)
	destroy_speech_bubble()
	closemessage
	msgbox("Cheren: Um. I'm Cheren, from\n"
		"Nuvema Town.\p"
		"My goal as a Trainer is to\n"
		"become the Champion.", MSGBOX_DEFAULT, TRUE, LOCALID_ROUTE5_CHEREN)
	destroy_speech_bubble()
	closemessage
	msgbox("Alder: Hm. Traveling with a goal in mind\n"
		"is a commendable thing.\p"
		"And what do you plan to do\n"
		"after becoming the Champion?", MSGBOX_DEFAULT, TRUE, LOCALID_ROUTE5_ALDER)
	destroy_speech_bubble()
	closemessage
	playse(SE_M_HYPER_BEAM2)
	applymovement(LOCALID_ROUTE5_CHEREN, moves(emote_question_mark))
	waitmovement(0)
    delay(20)
    waitse
	msgbox("Cheren: What else is there other than\n"
		"striving to become stronger?\p"
		"The strongest Trainer--\n"
		"that's the Champion.", MSGBOX_DEFAULT, TRUE, LOCALID_ROUTE5_CHEREN)
	destroy_speech_bubble()
	closemessage
	msgbox("Alder: Hmm. Becoming stronger...\n"
		"Becoming stronger, you say...\l"
		"Is that alone enough of a goal? Hmmm.\p"
		"It's not that I'm trying to say your way\n"
		"of thinking is wrong...", MSGBOX_DEFAULT, TRUE, LOCALID_ROUTE5_ALDER)
	destroy_speech_bubble()
	closemessage
	applymovement(LOCALID_ROUTE5_ALDER, moves(walk_in_place_down))
	waitmovement(0)
	delay(10)
	msgbox("Alder: In my travels, I've helped many\n"
		"people learn to love Pokémon. I think\l"
		"that's important, too.\p"
		"If you play with those children, you\n"
		"might gain more of an understanding.\p"
		"Will you two have a Pokémon battle\n"
		"with those two?", MSGBOX_DEFAULT, TRUE, LOCALID_ROUTE5_ALDER)
	destroy_speech_bubble()
	closemessage
	applymovement(LOCALID_ROUTE5_ALDER, moves(walk_in_place_up))
	waitmovement(0)
	delay(10)
	msgbox("Hey, you two. Come\n"
		"here for a moment.", MSGBOX_DEFAULT, TRUE, LOCALID_ROUTE5_ELESA)
	destroy_speech_bubble()
	closemessage
	applymovement(LOCALID_ROUTE5_ALDER, moves(walk_left * 2, walk_in_place_right))
	applymovement(LOCALID_ROUTE5_PRESCHOOLERF, moves(walk_down * 3))
	applymovement(LOCALID_ROUTE5_PRESCHOOLERM, moves(walk_down * 2, walk_left, walk_in_place_down))
	waitmovement(0)
	delay(10)
	msgbox("Cheren: ...Understood.\p"
		"But, before that...", MSGBOX_DEFAULT, TRUE, LOCALID_ROUTE5_CHEREN)
	destroy_speech_bubble()
	closemessage
	applymovement(LOCALID_ROUTE5_CHEREN, moves(walk_in_place_left))
	waitmovement(0)
	delay(10)
	playse(SE_USE_ITEM)
	special(HealPlayerParty)
	msgbox("Cheren fully healed\n"
		"{PLAYER}'s Pokémon!", MSGBOX_TRANSPARENT, FALSE)
	waitmessage
	waitse
	closemessage
	delay(10)
    goto(Route5_EventScript_ChooseParty)
}

script Route5_EventScript_TCB_Pos1
{
	applymovement(LOCALID_PLAYER, moves(walk_down, walk_in_place_right))
	applymovement(LOCALID_ROUTE5_CHEREN, moves(walk_left, walk_up, walk_left * 2))
	waitmovement(0)
	return
}

