script Route5_EventScript_ChooseParty
{
	special(SavePlayerParty)
	fadescreen(FADE_TO_BLACK)
	special(ChooseHalfPartyForBattle)
	goto_if_ne(VAR_RESULT, 0, Route5_EventScript_DoMultibattle)
	special(LoadPlayerParty)
	goto(Route5_EventScript_ChooseParty)
}

script Route5_EventScript_DoMultibattle
{
	applymovement(LOCALID_ROUTE5_CHEREN, moves(walk_in_place_up))
	waitmovement(0)
	delay(10)
	msgbox("Cheren: OK, let's battle.", MSGBOX_DEFAULT, TRUE, LOCALID_ROUTE5_CHEREN)
	destroy_speech_bubble()
	closemessage
	goto_if_set(FLAG_CHOSE_SNIVY, Route5_EventScript_DoMultibattle_Tepig)
	goto_if_set(FLAG_CHOSE_TEPIG, Route5_EventScript_DoMultibattle_Oshawott)
	goto_if_set(FLAG_CHOSE_OSHAWOTT, Route5_EventScript_DoMultibattle_Snivy)
    end
}

script Route5_EventScript_DoMultibattle_Tepig
{
    multi_2_vs_2(TRAINER_PRESCHOOLER_F_ROUTE_5, text("My Pokémon was so cute!"),
    TRAINER_PRESCHOOLER_M_ROUTE_5, text("My Pokémon listened to what I said\nand fought for me!"), PARTNER_CHEREN_ROUTE5_TEPIG)
	goto_if_eq(VAR_RESULT, 1, Route5_EventScript_FinishedMultibattle)
	fadescreen(FADE_TO_BLACK)
	special(SetCB2WhiteOut)
    end
}

script Route5_EventScript_DoMultibattle_Oshawott
{
    multi_2_vs_2(TRAINER_PRESCHOOLER_F_ROUTE_5, text("My Pokémon was so cute!"),
    TRAINER_PRESCHOOLER_M_ROUTE_5, text("My Pokémon listened to what I said\nand fought for me!"), PARTNER_CHEREN_ROUTE5_OSHAWOTT)
	goto_if_eq(VAR_RESULT, 1, Route5_EventScript_FinishedMultibattle)
	fadescreen(FADE_TO_BLACK)
	special(SetCB2WhiteOut)
    end
}

script Route5_EventScript_DoMultibattle_Snivy
{
    multi_2_vs_2(TRAINER_PRESCHOOLER_F_ROUTE_5, text("My Pokémon was so cute!"),
    TRAINER_PRESCHOOLER_M_ROUTE_5, text("My Pokémon listened to what I said\nand fought for me!"), PARTNER_CHEREN_ROUTE5_SNIVY)
	goto_if_eq(VAR_RESULT, 1, Route5_EventScript_FinishedMultibattle)
	fadescreen(FADE_TO_BLACK)
	special(SetCB2WhiteOut)
    end
}

script Route5_EventScript_FinishedMultibattle
{
	msgbox("Alder: Nicely done! You didn't win, but\n"
		"that was a good battle. Your Pokémon\l"
		"looked like they were having fun.", MSGBOX_DEFAULT, TRUE, LOCALID_ROUTE5_ALDER)
	destroy_speech_bubble()
	closemessage
	applymovement(LOCALID_ROUTE5_ALDER, moves(walk_in_place_down))
	waitmovement(0)
	delay(10)
	msgbox("Alder: Young man, if there are people\n"
		"like you who pursue strength,\l"
		"there are also people who are\l"
		"happy just being with Pokémon.\p"
		"There are many different people\n"
		"and many different answers.\p"
		"When it comes to what a Champion\n"
		"should be, you and I may hold differing\l"
		"views, but so be it! Give it some thought.", MSGBOX_DEFAULT, TRUE, LOCALID_ROUTE5_ALDER)
	destroy_speech_bubble()
	closemessage
	applymovement(LOCALID_ROUTE5_ELESA, moves(walk_in_place_right))
	waitmovement(0)
	delay(10)
	msgbox("Elesa: Let's roll.\n"
		"The Driftveil Drawbridge is just ahead.", MSGBOX_DEFAULT, TRUE, LOCALID_ROUTE5_ELESA)
	destroy_speech_bubble()
	closemessage
	applymovement(LOCALID_ROUTE5_ELESA, moves(walk_left * 7))
	waitmovement(0)
	removeobject(LOCALID_ROUTE5_ELESA)
	special(SpawnCameraObject)
	applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_down * 2))
	waitmovement(0)
	special(RemoveCameraObject)
	applymovement(LOCALID_ROUTE5_CHEREN, moves(walk_in_place_down))
	waitmovement(0)
	delay(10)
	msgbox("Cheren: The Champion is the strongest\n"
		"of the strong! That's all there is to it.", MSGBOX_DEFAULT, TRUE, LOCALID_ROUTE5_CHEREN)
	destroy_speech_bubble()
	closemessage
	applymovement(LOCALID_ROUTE5_CHEREN, moves(walk_down, walk_left * 9))
	waitmovement(0)
	removeobject(LOCALID_ROUTE5_CHEREN)
	setvar(VAR_ROUTE_5_STATE, 2)
	clearflag(FLAG_TEMP_11)
	clearflag(FLAG_ROUTE_5_ELESA_AT_BRIDGE)
	fadedefaultbgm
	savebgm(MUS_BW_ROUTE_4)
	delay(20)
	release
	end
}

script Route5_EventScript_Trigger_LowerBridge
{
	lock
	delay(10)
	release
	end
}
