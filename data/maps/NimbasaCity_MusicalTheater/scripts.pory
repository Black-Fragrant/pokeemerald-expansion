script NimbasaCity_MusicalTheater_EventScript_Receptionist_Right
{
    lock
    faceplayer
    msgbox("Welcome to the Pokémon Musical!\p"
       "This is a changing room for Dress Up only.\n"
       "Would you like to Dress Up your Pokémon?", MSGBOX_DEFAULT, TRUE, LOCALID_NCMT_RECEPTION_RIGHT)
